+//
+// You should have received a copy of the GNU General Public License
+// along with Proton Mail Bridge. If not, see <https://www.gnu.org/licenses/>.
+
+//go:build linux && nofido
+
+package grpc
+
+import (
+	"context"
+
+	"google.golang.org/protobuf/types/known/emptypb"
+)
+
+func (s *Service) LoginFido(_ context.Context, login *LoginRequest) (*emptypb.Empty, error) {
+	s.log.WithField("username", login.Username).Debug("LoginFido unsupported")
+	_ = s.SendEvent(NewLoginError(LoginErrorType_FIDO_ERROR, "Security keys are not supported in this build."))
+	s.loginClean()
+	return &emptypb.Empty{}, nil
+}
