+//go:build linux && nofido
+
+// Build without libfido2 (and cgo for it): security keys are unsupported.
+
+package fido
+
+import (
+	"context"
+	"errors"
+
+	"github.com/ProtonMail/go-proton-api"
+)
+
+var ErrAssertionCancelled = errors.New("FIDO assertion cancelled")
+
+var ErrUnsupported = errors.New("security keys are not supported in this build")
+
+func IsPinSupported() (bool, error) {
+	return false, ErrUnsupported
+}
+
+func AuthWithHardwareKeyGUI(_ context.Context, _ *proton.Client, _ proton.Auth, _ chan struct{}, _ chan struct{}, _ string) error {
+	return ErrUnsupported
+}
+
+func AuthWithHardwareKeyCLI(_ CLIProvider, _ *proton.Client, _ proton.Auth) error {
+	return ErrUnsupported
+}
